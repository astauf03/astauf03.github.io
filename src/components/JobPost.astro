---
const { url, title, summary, image, company, pubDate, alt = "", feature = false } = Astro.props;
const external = url.startsWith("http");
---
<a
  class:list={["card-link", { "card-link--feature": feature }]}
  href={url}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  {image && (
    <span class="card-image-wrapper">
      <img class="card-image" src={image.src} alt={alt} />
    </span>
  )}
  <h3 class="card-job">{title}</h3>
  <h4 class="card-job">{company}</h4>
  <h3 class="card-job">{pubDate}</h3>
  {summary && <p class="card-summary">{summary}</p>}
  <span class="card-arrow" aria-hidden="true">→</span>
</a>

<style>
  .card-job {
    font-size: 1.2rem;
    font-weight: 600;
    line-clamp: 1;
}
 
</style>