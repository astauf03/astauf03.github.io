---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "About Me";

const identity = {
    firstName: "Alex",
    lastName: "Stauffer",
    country: "United States",
    occupation: "Looking for opportunities in GIS and policy analysis",
    hobbies: ["walking", "singing", "language learning", "traveling"]
}

const skills = [
    "GIS",
    "Python",
    "R",
    "Data Analysis",
    "Data Visualization",
    "SQL",
    "JavaScript",
    "HTML/CSS",
    "Academic Writing"
]

const happy = true;
const finished = true;
const goal = 3;

const skillColor = "deeppink";
const fontWeight = "bold";
const textCase = "uppercase";

import '../styles/global.css';
---

<BaseLayout pageTitle={pageTitle}>
     <style define:vars={{skillColor, fontWeight, textCase}}> 
            h2 {
                color: rgb(54, 18, 217);
                font-size: 2rem;
            } 
            .skill {
                color: var(--skillColor);
                font-weight: var(--fontWeight);
                text-transform: var(--textCase);
            } 
        </style>
        <h2> ... and my new Astro site (that will be my portfolio)</h2>

        <h3>Here are a few facts about me:</h3>
        <ul>
            <li><strong>Name:</strong> {identity.firstName} {identity.lastName}</li>
            <li><strong>Country:</strong> {identity.country}</li>
            <li><strong>Occupation:</strong> {identity.occupation}</li>
        </ul>

        <h3>Skills</h3>
        <ul>
            {skills.map((skill) => (
                <li class="skill">{skill}</li>
            ))}
        </ul>

        <h3>Hobbies</h3>
        <ul>
            {identity.hobbies.map((hobby) => (
                <li>{hobby}</li>
            ))}
        </ul>

        {happy && <p>I am happy to be learning Astro!</p>}
        
        {finished && <p>I have finished learning Astro!</p>}

        {goal === 3 ? <p>My goal is to finish in 3 days. </p> : <p>My goal is not to finish in 3 days.</p>}
        
</BaseLayout>