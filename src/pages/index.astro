---
import BaseLayout from '../layouts/BaseLayout.astro';
import Greeting from '../components/Greeting';
import PhotoCard from '../components/PhotoCard.astro';
const pageTitle = "Alexandra Stauffer";
---
<BaseLayout pageTitle={pageTitle}>
	<section class="hero">
		<div class="prose">
			<h2>Urban Spatial Analyst and Anthropologist</h2>
			<p> I am interested in the intersection of culture, langauge, and the spaces it occupies. I want to chase answers to how we can use geospatial technologies to better understand the human experience. </p>
			<p> A dream of mine is to work for the United Nations, UNICEF, Amnesty International, and other human rights organizations. I also applied for an English Teaching Assistant Fulbright Scholarship to South Korea.</p>
			<p>Currently I am collaborating with the <a href="https://dair-institute.org/projects/" target="_blank" rel="noopener noreferrer">Distributed AI Research Institute</a> on a project about pharmacy deserts in the context of spatial apartheid. Check it out below!</p>
		</div>
		<aside class="hero-side">
			<a href="/about">
				<PhotoCard class="headshot" src="/images/personal/walking.png" alt="Headshot of Alex" />
			</a>			
		</aside>
		<Greeting client:load messages={["Hello there, how are you", "잘 지냈어요", "最近元気ですか。", "Comment allez-vous", "您好吗", "Wie geht es ihnen"]} />
		<details>
			<summary> Psst..  </summary>
			<p>All of the languages chosen in this greeting feature are languages I have studied formally in years past.</p>
		</details>
		<a class="card-link card-link--feature" href="/posts/post01">
				<span class="card-image-wrapper">
					<img class="card-image" src="/images/projects/h1-access-share-by-settlement-type.png" alt="Healthcare access share by settlement type for both walking and driving in Gauteng and KwaZulu-Natal" />
				</span>
				<span class="card-label">Understanding Pharmacy Access in South Africa <span class="card-arrow">→</span></span>
				<p class="card-summary">Check out my current research project with the Distributed AI Research Institute!</p>
			</a>
	</section>

</BaseLayout>
